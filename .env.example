# Copy to .env.local and fill in. Never commit real values.
# Supabase project URL (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe in the browser; used only for auth.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Anthropic API key for /api/extract. Server only. Not used yet.
ANTHROPIC_API_KEY=
